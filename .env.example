# Environment Configuration for Investigation AI

# Use mock data (true/false)
# Set to false to use production Qdrant and PostgreSQL
USE_MOCK_DATA=true

# PostgreSQL Configuration
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DATABASE=investigation_ai
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_POOL_SIZE=10

# Qdrant Configuration
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION_NAME=document_chunks
QDRANT_API_KEY=
QDRANT_TIMEOUT=30

# OpenAI Configuration (for embeddings)
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSION=1536

# Embedding Configuration (fallback to sentence-transformers)
USE_OPENAI_EMBEDDINGS=false
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

# Chunking Configuration
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# Ingestion Configuration
INGESTION_BATCH_SIZE=100
